{
  "name": "dsh-plugin-preflight",
  "version": "0.1.0",
  "description": "Preflight checks for a DeepSeek Harness plugin before submitting it to the community list: verifies the dsh.bundle manifest, cordis.patch.yml wiring, client bundle shape, and prerelease-safe peer ranges.",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "preflight",
    "lint",
    "plugin-development"
  ],
  "type": "module",
  "license": "MIT",
  "author": "AphyTOT",
  "main": "lib/index.js",
  "bin": {
    "dsh-plugin-preflight": "bin/preflight.js"
  },
  "exports": {
    ".": "./lib/index.js",
    "./check": "./lib/check.js",
    "./package.json": "./package.json"
  },
  "files": [
    "bin",
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18.12"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AphyTOT/dsh-plugin-preflight.git"
  },
  "homepage": "https://github.com/AphyTOT/dsh-plugin-preflight#readme",
  "bugs": {
    "url": "https://github.com/AphyTOT/dsh-plugin-preflight/issues"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-tools": ">=0.1.0-rc.1 <0.2.0-0 || >=0.1.5-rc.1 <0.2.0-0"
  }
}